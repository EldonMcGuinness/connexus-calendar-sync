# Copy the needed settings into .secrets/calendar_sync.env on the server.

# Required: Connexus display names and web user IDs.
CONNEXUS_STUDENTS_JSON='[{"name":"Student One","web_user_id":"12345"},{"name":"Student Two","web_user_id":"67890"}]'

# Keep the existing value to preserve event UIDs across feed refreshes.
CONNEXUS_UID_DOMAIN=calendar.example.invalid

# Needed for automatic sign-in if the saved .secrets/connexus-state.json
# session is missing or expires.
CONNEXUS_USERNAME=your-connexus-username
CONNEXUS_PASSWORD=replace-with-your-connexus-password

# Optional: failure alerts. Leave unset if alerts are not configured.
# CONNEXUS_WEBHOOK_URL=

# CONNEXUS_AUTH_WEBHOOK_URL is also accepted as a legacy webhook setting.

